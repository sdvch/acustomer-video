# ===== 独立服务配置（与 storyboard-system 完全隔离）=====
SERVER_PORT=18080
GIN_MODE=debug
JWT_SECRET=change-me-acustomer-video-secret

# ===== 独立数据库（端口/库名/账号均独立，不得填 storyboard）=====
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=acustomer
DB_PASSWORD=acustomer_pwd
DB_NAME=acustomer_video
DB_CHARSET=utf8mb4

# ===== OSS：新 Bucket；AK/SK 复用现有 RAM 子账号（从旧项目 .env 复制值）=====
# 注意：需先在该子账号授权策略中追加对新 bucket 的读写权限，否则 403
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_PUBLIC_ENDPOINT=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=acustomer-video-prod
ALIYUN_OSS_OBJECT_PREFIX=acustomer-video/
ALIYUN_OSS_REGION=cn-shanghai

# ===== 本地存储降级（未配 OSS 时启用）=====
STORAGE_DIR=../storage
STORAGE_BASE_PATH=/storage

# ===== ffmpeg =====
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORK_DIR=../storage/work

# ===== 合成参数 =====
WORKER_COUNT=2
JOB_LEASE_SECONDS=120
COMPOSE_TIMEOUT_MINUTES=15
DEFAULT_CLIP_SECONDS=4
# 单镜头时长允许范围（SOP 3-5s，工程上放宽）
MIN_CLIP_SECONDS=2
MAX_CLIP_SECONDS=8
# 成片总时长强制区间（SOP 表10：25-35s）
MIN_DURATION_SECONDS=25
MAX_DURATION_SECONDS=35
# 素材段数范围
MIN_ASSET_COUNT=3
MAX_ASSET_COUNT=12
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
TARGET_BITRATE=12M

# ===== 微信小程序登录（code2session）=====
# 填了才会走真实微信登录；留空则降级为本地开发单用户（dev_mode）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ===== 文本大模型：DeepSeek（文案生成，复用短剧项目同一个 key）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
