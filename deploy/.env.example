# 独立 compose stack 环境变量（端口与旧项目错开）
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=acustomer_video
DB_USER=acustomer
DB_PASSWORD=acustomer_pwd
MYSQL_HOST_PORT=13306
SERVER_HOST_PORT=18080
# 本地存储模式下 file_url 拼成的绝对地址前缀（IP 或域名，不带结尾斜杠）
PUBLIC_BASE_URL=http://127.0.0.1:18080

# 后端运行时（传给 app 容器）
JWT_SECRET=change-me-acustomer-video-secret
ALIYUN_OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=acustomer-video-prod
ALIYUN_OSS_OBJECT_PREFIX=acustomer-video/

# 微信登录（留空=本地开发单用户）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# DeepSeek 文案（复用短剧项目同一个 key）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 管理后台首个超管（admins 表为空时种子创建一次；密码留空则启动时生成随机密码打日志）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
